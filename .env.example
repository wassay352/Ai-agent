# Which provider to use: ollama | groq | openrouter
PROVIDER=ollama

# --- Ollama (local, private, no key needed) ---
# Start it with: ollama serve
# Pull a model first: ollama pull qwen2.5-coder:7b
OLLAMA_API_KEY=ollama

# --- Groq (cloud, fast, free tier) ---
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter (cloud, many models) ---
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model for the active provider.
# Ollama:     qwen2.5-coder:7b | llama3.2:3b | deepseek-coder-v2
# Groq:       llama-3.3-70b-versatile | llama-3.1-8b-instant
# OpenRouter: anthropic/claude-3.5-sonnet | google/gemini-flash-1.5
MODEL=

# Optional: extra standing instructions appended to the system prompt.
SYSTEM_PROMPT_EXTRA=
